# Select one local profile from config/ and review it before use.
APP_ENV=local-release
BACKEND_PORT=8300
FRONTEND_PORT=3300
AUTOQA_SAFE_MODE=true
AUTOQA_DEBUG=false
AUTOQA_ALLOW_PRODUCTION_EXECUTION=false
AUTOQA_ALLOW_REAL_TARGET_EXECUTION=false
AUTOQA_TLS_VERIFY=true
AUTOQA_FRONTEND_URL=http://127.0.0.1:3300

