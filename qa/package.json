{
  "name": "ifive-autoqa-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "test:phase3": "playwright test tests/phase3-task-connector.spec.ts --project=chromium --workers=1",
    "test:phase3:core": "playwright test tests/phase3-task-connector.spec.ts --project=chromium --grep \"PASS|FAIL|BLOCKED\" --workers=1",
    "demo:proxy": "node demo-product-proxy.mjs",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.7.2"
  }
}
