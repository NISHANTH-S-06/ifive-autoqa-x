APP_ENV=test
DATABASE_URL=sqlite:///./data/autoqa-test.db
AUTOQA_DATA_ROOT=./data
AUTOQA_RUNTIME_ROOT=../runtime/test
AUTOQA_BACKUP_ROOT=../runtime/test/backups
AUTOQA_QA_RUNS_ROOT=../qa/reports/runs
AUTOQA_SAFE_MODE=true
AUTOQA_DEBUG=false
AUTOQA_ALLOW_PRODUCTION_EXECUTION=false
AUTOQA_ALLOW_REAL_TARGET_EXECUTION=false
AUTOQA_TLS_VERIFY=true
AUTOQA_FRONTEND_URL=http://127.0.0.1:5173
AUTOQA_COOKIE_SECURE=false
AUTOQA_RETENTION_ARTIFACT_DAYS=7
AUTOQA_RETENTION_EVIDENCE_DAYS=7
AUTOQA_RETENTION_EXPORT_DAYS=7
AUTOQA_RETENTION_OPERATIONAL_DAYS=7
