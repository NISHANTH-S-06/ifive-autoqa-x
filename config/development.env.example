APP_ENV=development
DATABASE_URL=sqlite:///./data/autoqa-development.db
AUTOQA_DATA_ROOT=./data
AUTOQA_RUNTIME_ROOT=../runtime/development
AUTOQA_BACKUP_ROOT=../runtime/development/backups
AUTOQA_QA_RUNS_ROOT=../qa/reports/runs
BACKEND_PORT=8300
FRONTEND_PORT=3300
AUTOQA_SAFE_MODE=true
AUTOQA_DEBUG=true
AUTOQA_ALLOW_PRODUCTION_EXECUTION=false
AUTOQA_ALLOW_REAL_TARGET_EXECUTION=false
AUTOQA_TLS_VERIFY=true
AUTOQA_FRONTEND_URL=http://127.0.0.1:3300
AUTOQA_COOKIE_SECURE=false

