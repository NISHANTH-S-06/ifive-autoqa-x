APP_ENV=local-release
DATABASE_URL=sqlite:///./data/autoqa.db
AUTOQA_DATA_ROOT=./data
AUTOQA_RUNTIME_ROOT=../runtime
AUTOQA_BACKUP_ROOT=../runtime/backups
AUTOQA_QA_RUNS_ROOT=../qa/reports/runs
AUTOQA_SAFE_MODE=true
AUTOQA_DEBUG=false
AUTOQA_ALLOW_PRODUCTION_EXECUTION=false
AUTOQA_ALLOW_REAL_TARGET_EXECUTION=false
AUTOQA_TLS_VERIFY=true
AUTOQA_FRONTEND_URL=http://127.0.0.1:5173
AUTOQA_COOKIE_SECURE=false
AUTOQA_ALLOWED_ENVIRONMENTS=local,development,qa,staging
AUTOQA_RUN_TIMEOUT_SECONDS=900
AUTOQA_SESSION_HOURS=8
AUTOQA_PASSWORD_MAX_AGE_DAYS=0
AUTOQA_RETENTION_ARTIFACT_DAYS=30
AUTOQA_RETENTION_EVIDENCE_DAYS=90
AUTOQA_RETENTION_EXPORT_DAYS=30
AUTOQA_RETENTION_OPERATIONAL_DAYS=30
AUTOQA_LOG_MAX_BYTES=5242880
AUTOQA_LOG_BACKUP_COUNT=5
AUTOQA_DISK_WARNING_MB=1024
